# PostgreSQL 접속 주소 (비동기 드라이버 asyncpg 사용)
# docker compose로 실행할 때는 호스트를 db로 둔다. 로컬에서 직접 실행할 때는 localhost로 바꾼다.
DATABASE_URL=postgresql+asyncpg://board:board-password@db:5432/board

# JWT 서명 키: 아래 명령으로 만든 임의의 값으로 반드시 교체한다.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# docker compose의 PostgreSQL 컨테이너 설정 (DATABASE_URL과 값이 같아야 한다)
POSTGRES_USER=board
POSTGRES_PASSWORD=board-password
POSTGRES_DB=board

# CORS 허용 출처 (쉼표로 구분). 모두 허용하려면 *
CORS_ORIGINS=*

# 게시글 목록 캐시 유지 시간(초)
CACHE_TTL_SECONDS=30
